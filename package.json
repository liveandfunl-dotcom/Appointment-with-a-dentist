{
  "name": "dentist-appointments",
  "private": true,
  "version": "0.0.0",
  "description": "Система записи пациентов на приём к стоматологу",
  "workspaces": [
    "backend",
    "frontend",
    "tests"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "test:api": "npm run test:api -w tests",
    "test:frontend": "npm run test:frontend -w tests",
    "test:e2e": "npm run test:e2e -w tests",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:all": "npm run dev:backend & npm run dev:frontend & wait",
    "build": "npm run build -w backend && npm run build -w frontend"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
