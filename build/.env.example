# Скопируйте в build/.env и поправьте значения.
# Внешний адрес приложения (используется в ссылках magic link).
APP_URL=http://localhost:3000
CLINIC_TZ=Europe/Athens
# true — создать тестовых врачей и администратора. В рабочей среде уберите.
SEED_DEV=true
# SMTP: по умолчанию Mailpit из docker-compose.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Clinic <noreply@clinic.local>

# Порты на хосте (внутри контейнеров всегда 3000, 1025, 8025).
APP_PORT=3000
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
