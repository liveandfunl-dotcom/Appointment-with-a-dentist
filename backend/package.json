{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsc -p tsconfig.build.json && (tsc -p tsconfig.build.json --watch --preserveWatchOutput & node --watch-path=dist dist/main.js)",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "~12.6.3",
    "@nestjs/core": "~12.6.3",
    "@nestjs/platform-express": "~12.6.3",
    "cookie-parser": "^1.4.7",
    "luxon": "^3.7.2",
    "nodemailer": "^10.6.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.6",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2"
  }
}
